{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Upper East Horology design tokens. Flat-black, turquoise, and silver are the only UI palette; the duplicated light set exists solely for component compatibility. TODO(brand): re-sample exact values when the client logo is delivered.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#000000", "$description": "Flat black is the only page canvas; this compatibility set deliberately does not produce a light mode." },
      "foreground": { "$value": "#C7CDD6" },
      "border": { "$value": "#303840" },
      "card": { "$value": "#080808" },
      "cardForeground": { "$value": "#C7CDD6" },
      "popover": { "$value": "#0C0C0C" },
      "popoverForeground": { "$value": "#C7CDD6" },
      "primary": {
        "$value": "#1FA89C",
        "$description": "Laguna turquoise for primary actions and interactive emphasis."
      },
      "primaryForeground": { "$value": "#000000" },
      "secondary": { "$value": "#111111" },
      "secondaryForeground": { "$value": "#C7CDD6" },
      "muted": { "$value": "#101010" },
      "mutedForeground": { "$value": "#9099A4" },
      "accent": {
        "$value": "#3FE0D0",
        "$description": "Bright turquoise highlight for links, focus, and selected states."
      },
      "accentForeground": { "$value": "#000000" },
      "destructive": { "$value": "#D05260" },
      "destructiveForeground": { "$value": "#000000" },
      "input": { "$value": "#65717D", "$description": "Field boundaries exceed 3:1 contrast against supported dark field surfaces." },
      "ring": { "$value": "#3FE0D0" },
      "chart1": { "$value": "#3FE0D0" },
      "chart2": { "$value": "#1FA89C" },
      "chart3": { "$value": "#C7CDD6" },
      "chart4": { "$value": "#3FE0D0" },
      "chart5": { "$value": "#9B7E4D" },
      "sidebar": { "$value": "#050505" },
      "sidebarForeground": { "$value": "#C7CDD6" },
      "sidebarBorder": { "$value": "#303840" },
      "sidebarPrimary": { "$value": "#3FE0D0" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent": { "$value": "#151515" },
      "sidebarAccentForeground": { "$value": "#C7CDD6" },
      "sidebarRing": { "$value": "#3FE0D0" }
    },
    "dark": {
      "background": {
        "$value": "#000000",
        "$description": "Flat black is the dominant page background."
      },
      "foreground": { "$value": "#C7CDD6" },
      "border": { "$value": "#303840" },
      "card": { "$value": "#080808" },
      "cardForeground": { "$value": "#C7CDD6" },
      "popover": { "$value": "#0C0C0C" },
      "popoverForeground": { "$value": "#C7CDD6" },
      "primary": {
        "$value": "#3FE0D0",
        "$description": "Turquoise primary action color on dark surfaces."
      },
      "primaryForeground": { "$value": "#000000" },
      "secondary": { "$value": "#111111" },
      "secondaryForeground": { "$value": "#C7CDD6" },
      "muted": { "$value": "#101010" },
      "mutedForeground": { "$value": "#9099A4" },
      "accent": {
        "$value": "#C7CDD6",
        "$description": "Silver metallic accent for borders, secondary actions, and precision details."
      },
      "accentForeground": { "$value": "#000000" },
      "destructive": { "$value": "#D05260" },
      "destructiveForeground": { "$value": "#000000" },
      "input": { "$value": "#65717D", "$description": "Field boundaries exceed 3:1 contrast against supported dark field surfaces." },
      "ring": { "$value": "#3FE0D0" },
      "chart1": { "$value": "#3FE0D0" },
      "chart2": { "$value": "#1FA89C" },
      "chart3": { "$value": "#C7CDD6" },
      "chart4": { "$value": "#7A8DA1" },
      "chart5": { "$value": "#C19A5B" },
      "sidebar": { "$value": "#050505" },
      "sidebarForeground": { "$value": "#C7CDD6" },
      "sidebarBorder": { "$value": "#303840" },
      "sidebarPrimary": { "$value": "#3FE0D0" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent": { "$value": "#151515" },
      "sidebarAccentForeground": { "$value": "#C7CDD6" },
      "sidebarRing": { "$value": "#3FE0D0" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "sans-serif"],
        "$description": "Geometric sans for wordmarks, headings, controls, and body copy."
      },
      "serif": {
        "$value": ["Playfair Display", "serif"],
        "$description": "Editorial counterpoint for quotations and long-form guide accents."
      },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Tight, precision-machined corner treatment; larger radii derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
